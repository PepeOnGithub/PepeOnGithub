{
"container_item": {
    "$base_id|default": "$brewing_guide:potion",
    "$potion_prefix|default": "",
    "$custom_slot_content|default": "common.empty_panel",
    "$item_collection|default": "$item_collection_name",
    "variables": [
      {"requires":"($item_collection_name = 'brewing_input_item')","$custom_slot_content":"brewing_potion_slot.brewing_ingredient_item_slot"},
      {"requires":"($item_collection_name = 'brewing_result_items')","$custom_slot_content":"brewing_potion_slot.brewing_result_item_slot"},
      {"requires":"($item_collection_name = 'brewing_fuel_item')","$custom_slot_content":"brewing_potion_slot.fuel_input_slot"}
    ],
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {"slot_refrence@$custom_slot_content": {}}
        ]
      }
    ]
  },
  "container_item": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "replace",
        "control_name": "item_button_ref",
        "value": [{ "item_movement_element@item_data.item_movement_factory": {} }]
      }
    ]
  },
  "item_renderer": {
    "property_bag": {
      "#filtered_light_multiplier": 0.2
    },
    "modifications": [
      {
        "array_name": "bindings",
        "operation": "insert_back",
        "value": [
          {
            "binding_type": "collection",
            "binding_collection_name": "$item_collection_name",
            "binding_name": "#hover_text"
          },
          {
            "binding_type": "view",
            "source_control_name": "utility_search_box",
            "source_property_name": "#item_name",
            "target_property_name": "#item_name"
          },
          {
            "binding_type": "view",
            "ignored": "((not (($screen_content - 'cartography' - 'crafting' - 'anvil' - 'smoke' - 'furnace') = $screen_content)) or (not (($item_collection_name - 'bundle_items' - 'recipe_book' - 'result' - 'output') = $item_collection_name)))",
            "source_property_name": "((not (#item_name = '')) and ((#hover_text - #item_name) = #hover_text))",
            "target_property_name": "#disabled_filter_visible"
          }
        ]
      }
    ]
  }
}
