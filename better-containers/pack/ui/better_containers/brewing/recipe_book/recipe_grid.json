{
  "namespace": "bc_brewing_recipe_grid",
  "recipe_book_grid@bc_brewing_common.text_keys": {
    "type": "grid",
    "grid_dimensions": "$brewing_grid_dimensions",
    "size": "$brewing_grid_size",
    "anchor_from": "$brewing_grid_anchor_from",
    "anchor_to": "$brewing_grid_anchor_to",
    "offset": "$brewing_grid_offset",
    "$grid_item|default": "bc_brewing_recipe_grid.recipe_grid_item",
    "$has_duration|default": true,
    "$has_potency|default": true,
    "$potion_prefix|default": "",
    "controls": [
      {
        "potion_1@$grid_item": {
          "$has_potency": false,
          "$has_duration": false,
          "grid_position": "$brewing_grid_position_0",
          "$collection_index": 1,
          "$potion_key_type": "is_awkward_potion_key",
          "$remainder": "$bc_brewing:awkward_potion"
        }
      },
      {
        "potion_2@$grid_item": {
          "$has_potency": false,
          "grid_position": "$brewing_grid_position_1",
          "$collection_index": 2,
          "$potion_key_type": "is_night_vision_key",
          "$remainder": "$bc_brewing:potion_of_night_vision"
        }
      },
      {
        "potion_3@$grid_item": {
          "$has_potency": false,
          "grid_position": "$brewing_grid_position_2",
          "$collection_index": 3,
          "$potion_key_type": "is_invisibility_key",
          "$remainder": "$bc_brewing:potion_of_invisibility"
        }
      },
      {
        "potion_4@$grid_item": {
          "grid_position": "$brewing_grid_position_3",
          "$collection_index": 4,
          "$potion_key_type": "is_leaping_key",
          "$remainder": "$bc_brewing:potion_of_leaping"
        }
      },
      {
        "potion_5@$grid_item": {
          "$has_potency": false,
          "grid_position": "$brewing_grid_position_4",
          "$collection_index": 5,
          "$potion_key_type": "is_fire_resistance_key",
          "$remainder": "$bc_brewing:potion_of_fire_resistance"
        }
      },
      {
        "potion_6@$grid_item": {
          "grid_position": "$brewing_grid_position_5",
          "$collection_index": 6,
          "$potion_key_type": "is_swiftness_key",
          "$remainder": "$bc_brewing:potion_of_swiftness"
        }
      },
      {
        "potion_7@$grid_item": {
          "grid_position": "$brewing_grid_position_6",
          "$collection_index": 7,
          "$potion_key_type": "is_slowness_key",
          "$remainder": "$bc_brewing:potion_of_slowness"
        }
      },
      {
        "potion_8@$grid_item": {
          "$has_potency": false,
          "grid_position": "$brewing_grid_position_7",
          "$collection_index": 8,
          "$potion_key_type": "is_water_breathing_key",
          "$remainder": "$bc_brewing:potion_of_water_breathing"
        }
      },
      {
        "potion_9@$grid_item": {
          "$has_duration": false,
          "grid_position": "$brewing_grid_position_8",
          "$collection_index": 9,
          "$potion_key_type": "is_healing_key",
          "$remainder": "$bc_brewing:potion_of_healing"
        }
      },
      {
        "potion_10@$grid_item": {
          "$has_duration": false,
          "grid_position": "$brewing_grid_position_9",
          "$collection_index": 10,
          "$potion_key_type": "is_harming_key",
          "$remainder": "$bc_brewing:potion_of_harming"
        }
      },
      {
        "potion11@$grid_item": {
          "grid_position": "$brewing_grid_position_10",
          "$collection_index": 11,
          "$potion_key_type": "is_poison_key",
          "$remainder": "$bc_brewing:potion_of_poison"
        }
      },
      {
        "potion12@$grid_item": {
          "grid_position": "$brewing_grid_position_11",
          "$collection_index": 12,
          "$potion_key_type": "is_regeneration_key",
          "$remainder": "$bc_brewing:potion_of_regeneration"
        }
      },
      {
        "potion13@$grid_item": {
          "grid_position": "$brewing_grid_position_12",
          "$collection_index": 13,
          "$potion_key_type": "is_strength_key",
          "$remainder": "$bc_brewing:potion_of_strength"
        }
      },
      {
        "potion14@$grid_item": {
          "$has_potency": false,
          "grid_position": "$brewing_grid_position_13",
          "$collection_index": 14,
          "$potion_key_type": "is_weakness_key",
          "$remainder": "$bc_brewing:potion_of_weakness"
        }
      },
      {
        "potion15@$grid_item": {
          "grid_position": "$brewing_grid_position_14",
          "$collection_index": 15,
          "$potion_key_type": "is_turtle_master_key",
          "$remainder": "$bc_brewing:potion_of_the_turtle_master"
        }
      },
      {
        "potion16@$grid_item": {
          "$has_potency": false,
          "grid_position": "$brewing_grid_position_15",
          "$collection_index": 16,
          "$potion_key_type": "is_slow_falling_key",
          "$remainder": "$bc_brewing:potion_of_slow_falling"
        }
      },
      {
        "potion17@$grid_item": {
          "$has_potency": false,
          "$has_duration": false,
          "grid_position": "$brewing_grid_position_16",
          "$collection_index": 17,
          "$potion_key_type": "is_wind_charging_key",
          "$remainder": "$bc_brewing:potion_of_wind_charging"
        }
      },
      {
        "potion18@$grid_item": {
          "$has_potency": false,
          "$has_duration": false,
          "grid_position": "$brewing_grid_position_17",
          "$collection_index": 18,
          "$potion_key_type": "is_weaving_key",
          "$remainder": "$bc_brewing:potion_of_weaving"
        }
      },
      {
        "potion19@$grid_item": {
          "$has_potency": false,
          "$has_duration": false,
          "grid_position": "$brewing_grid_position_18",
          "$collection_index": 19,
          "$potion_key_type": "is_oozing_key",
          "$remainder": "$bc_brewing:potion_of_oozing"
        }
      },
      {
        "potion20@$grid_item": {
          "$has_potency": false,
          "$has_duration": false,
          "grid_position": "$brewing_grid_position_19",
          "$collection_index": 20,
          "$potion_key_type": "is_infested_key",
          "$remainder": "$bc_brewing:potion_of_infestation"
        }
      },
      {
        "filler@$brewing_grid_filler_control": {
          "ignored": "($brewing_grid_filler_control = 'bc_brewing_common.empty_panel')"
        }
      }
    ],
    "collection_name": "$item_collection",
    "$item_collection": "brewing_recipe_items",
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "$visible_condition",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  "item_toggle@bc_brewing_toggles.toggle": {
    "$item_index_id|default": "($collection_index + $index_offset)"
  },
  "recipe_grid_item@bc_brewing_recipe_grid.item_toggle": {
    "size": "$grid_item_size",
    "$toggle_forced_index": "$item_index_id",
    "$toggle_collection_name": "brewing_items",
    "$toggle_control_name": "('potion_item_' + $item_index_id)",
    "$toggle_binding_value": "('#item_' + $item_index_id)",
    "$toggle_extra_properties": "bc_brewing_recipe_grid.primary_toggle_properties"
  },
  "primary_toggle_properties": {
    "unchecked_hover_control": "hover",
    "checked_hover_control": "hover",
    "$secondary_toggle_holder": "bc_brewing_recipe_grid.secondary_toggles",
    "controls": [
      {
        "hover@$slot_hover_controller": {
          "ignored": "($slot_hover_controller = 'bc_brewing_common.empty_panel')",
          "layer": 7
        }
      },
      {
        "craftable_slot@bc_brewing_recipe_grid.craftable_slot": {}
      },
      {
        "overlay_noclick_area@$secondary_toggle_holder": {
          "$duration_toggle_index|default": "(1000 + $item_index_id)"
        }
      }
    ]
  },
  "secondary_toggles@bc_brewing_common.root_panel": {
    "size": [
      "100%c",
      "100%c"
    ],
    "layer": 13,
    "$potency_toggle_index|default": "(1000 + $duration_toggle_index)",
    "anchor_from": "bottom_middle",
    "anchor_to": "top_middle",
    "offset": "$recipe_overlay_offset",
    "controls": [
      {
        "recipe_overlay@bc_brewing_common.empty_image": {
          "size": "$recipe_overlay_size",
          "nineslice_size": "$recipe_overlay_nineslice_size",
          "texture": "$brewing_overlay_texture",
          "controls": [
            {
              "additional_toggle_stack@bc_brewing_common.empty_stack": {
                "size": [
                  "100%c",
                  "100%cm"
                ],
                "orientation": "horizontal",
                "anchor_from": "center",
                "anchor_to": "center",
                "controls": [
                  {
                    "duration_toggle@bc_brewing_recipe_grid.potency_toggle": {
                      "visible": "$has_duration",
                      "$secondary_toggle_forced_index": "$duration_toggle_index",
                      "$secondary_toggle_control_name": "('potion_item_' + $duration_toggle_index)",
                      "$secondary_toggle_binding_value": "('#is_potion_item_' + $duration_toggle_index)",
                      "$potion_prefix": "duration_"
                    }
                  },
                  {
                    "potency_toggle@bc_brewing_recipe_grid.potency_toggle": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "('potion_item_' + $duration_toggle_index)",
        "source_property_name": "#toggle_state",
        "target_property_name": "#is_secondary_1_selected"
      },
      {
        "binding_type": "view",
        "source_control_name": "('potion_item_' + $potency_toggle_index)",
        "source_property_name": "#toggle_state",
        "target_property_name": "#is_secondary_2_selected"
      },
      {
        "binding_type": "view",
        "source_control_name": "$toggle_control_name",
        "source_property_name": "#toggle_state",
        "target_property_name": "#is_parent_selected"
      },
      {
        "binding_type": "view",
        "source_property_name": "(($has_duration or $has_potency) and (#is_secondary_1_selected or #is_secondary_2_selected or #is_parent_selected))",
        "target_property_name": "#visible"
      }
    ]
  },
  "potency_toggle@bc_brewing_toggles.secondary_toggle": {
    "size": "$grid_item_size",
    "visible": "$has_potency",
    "$secondary_toggle_extra_properties": "bc_brewing_recipe_grid.secondary_toggle_properties",
    "$secondary_toggle_forced_index": "$potency_toggle_index",
    "$secondary_toggle_control_name": "('potion_item_' + $potency_toggle_index)",
    "$secondary_toggle_binding_value": "('#is_potion_item_' + $potency_toggle_index)",
    "$potion_prefix|default": "potency_"
  },
  "secondary_toggle_properties": {
    "unchecked_hover_control": "hover",
    "checked_hover_control": "hover",
    "controls": [
      {
        "hover@$slot_hover_controller": {
          "visible": "(not ($slot_hover_controller = 'bc_brewing_common.empty_panel'))",
          "layer": 7
        }
      },
      {
        "slot_icon@bc_brewing_recipe_grid.craftable_slot": {
          "texture": "$brewing_secondary_slot_texture",
          "$toggle_control_name": "$secondary_toggle_control_name"
        }
      }
    ]
  },
  "craftable_slot@bc_brewing_common.empty_image": {
    "texture": "$brewing_slot_texture",
    "layer": 2,
    "size": "$grid_item_size",
    "$checkmark_bindings|default": [
      {
        "binding_type": "view",
        "binding_condition": "always_when_visible",
        "source_control_name": "$toggle_control_name",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "hover_text@bc_brewing_common.hover_text_renderer": {}
      },
      {
        "checkmark@bc_brewing_common.empty_image": {
          "texture": "$brewing_slot_checkmark_texture",
          "size": "$grid_item_size",
          "layer": 3,
          "nineslice_size": "$checkmark_texture_nineslice_size",
          "bindings": "$checkmark_bindings"
        }
      },
      {
        "renderer@bc_brewing_common.item_renderer": {
          "anchor_from": "$grid_item_renderer_anchor_point",
          "anchor_to": "$grid_item_renderer_anchor_point",
          "offset": "$grid_item_renderer_offset",
          "layer": 8
        }
      }
    ]
  }
}
