          ],
          "layer": -200,
          "controls": [
            {
              "hover_text_control": {
                "type": "image",
                "texture": "textures/ui/purpleBorder",
                "size": [
                  "100%c + 10px",
                  "100%c + 8px"
                ],
                "nineslice_size": 4,
                "layer": 400,
                "offset": "$tooltip_offset",
                "anchor_from": "$tooltip_anchor",
                "anchor_to": "$tooltip_anchor",
                "propagate_alpha": true,
                "allow_clipping": false,
                "controls": [
                  {
                    "hover_text_label": {
                      "type": "label",
