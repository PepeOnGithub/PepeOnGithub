      "$awkward_potion_action",
      "$night_vision_action",
      "$invisibility_action",
      "$leaping_action",
      "$fire_resistance_action",
      "$swiftness_action",
      "$slowness_action",
      "$water_breathing_action",
      "$healing_action",
      "$harming_action",
      "$poison_action",
      "$regeneration_action",
      "$strength_action",
      "$weakness_action",
