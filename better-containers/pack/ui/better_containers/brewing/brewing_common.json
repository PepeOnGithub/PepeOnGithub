{
  "namespace": "bc_brewing_common",
  "item_renderer@bc_brewing_common.custom_renderer": {
    "$type": "inventory_item_renderer",
    "size": [
      16,
      16
    ],
    "anchor_from": "center",
    "anchor_to": "center",
    "property_bag": {
      "#item_id_aux": "(($base_id * 65536) + $remainder)"
    }
  },
  "item_slot_variables": {
    "always_listen_to_input": true,
    "consume_hover_events": false,
    "controls": [
      {
        "white_overlay@bc_brewing_common.empty_image": {
          "size": [
            18,
            18
          ],
          "nineslice_size": 2,
          "texture": "textures/better_containers/slots/cell_white.png",
          "layer": 12,
          "alpha": 0.1915
        }
      },
      {
        "uncraftable_slot@bc_brewing_common.empty_image": {
          "size": [
            18,
            18
          ],
          "nineslice_size": 2,
          "color": [
            0.996,
            0.0,
            0.008
          ],
          "alpha": 0.19,
          "layer": 4,
          "texture": "textures/better_containers/slots/cell_white.png"
        }
      },
      {
        "hover_text_element@bc_brewing_common.hover_text_renderer": {
          "variables": {
            "requires": "$touch",
            "$tooltip_offset": [
              -19,
              -1
            ],
            "$tooltip_anchor": "top_right"
          },
          "size": [
            18,
            18
          ]
        }
      },
      {
        "renderer@bc_brewing_common.item_renderer": {
          "layer": 6
        }
      }
    ]
  },
  "container_item_slot_overlay@bc_brewing_toggles.toggle": {
    "size": [
      18,
      18
    ],
    "layer": 2,
    "$toggle_starts_active": true,
    "$toggle_click_sound_volume": 0,
    "$toggle_forced_index": -1,
    "$toggle_collection_name": "brewing_items",
    "$toggle_control_name": "brewing_reset",
    "$toggle_binding_value": "#item_brewing_reset",
    "$toggle_extra_properties": "bc_brewing_common.item_slot_variables",
    "variables": {
      "requires": "$touch",
      "$toggle_mapping_type": "double_pressed"
    }
  },
  "factory@bc_brewing_common.text_keys": {
    "size": [
      18,
      18
    ],
    "$remainder|default": 0,
    "$base_id|default": 0,
    "$potion_prefix|default": "",
    "$factory_name|default": "Minecraft",
    "$awkward_potion_action|default": "",
    "$night_vision_action|default": "",
    "$invisibility_action|default": "",
    "$leaping_action|default": "",
    "$fire_resistance_action|default": "",
