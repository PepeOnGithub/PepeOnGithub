    "$translation_keys": "('#__' + ($potion_prefix + $potion_key_type))",
    "$tooltip_anchor|default": "top_left",
    "$tooltip_offset|default": [
      19,
      -1
    ],
    "controls": [
      {
        "input_postion_tracker": {
          "type": "input_panel",
          "follows_cursor": true,
          "always_handle_pointer": true,
          "size": [
