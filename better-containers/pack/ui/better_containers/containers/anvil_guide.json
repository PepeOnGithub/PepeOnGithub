                    "line_2@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.2"
                    }
                  },
                  {
                    "line_3@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.3"
                    }
                  },
                  {
                    "line_4@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.4"
                    }
                  },
                  {
                    "line_5@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.5"
                    }
                  },
                  {
                    "line_6@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.6"
                    }
                  },
                  {
                    "line_7@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.7"
                    }
                  },
                  {
                    "line_8@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.8"
                    }
                  },
                  {
                    "line_9@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.9"
                    }
                  },
                  {
                    "line_10@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.a"
                    }
                  },
                  {
                    "line_11@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.b"
                    }
                  },
                  {
                    "line_12@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.c"
                    }
                  },
                  {
                    "line_13@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.d"
                    }
                  },
                  {
                    "line_14@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.e"
                    }
                  },
                  {
                    "line_15@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.color.f"
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "color_tab_toggle",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "nametag_panel": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [
                  "100%",
                  "default"
                ],
                "controls": [
                  {
                    "line_0@bc_anvil_guide.text_row": {
                      "$line_text": "%bc_anvil_guide.nametag.empty"
                    }
                  }
                ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "nametag_tab_toggle",
