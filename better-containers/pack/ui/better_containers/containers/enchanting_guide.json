            14
          ],
          "offset": [
            0,
            2
          ]
        }
      },
      {
        "name_label": {
          "type": "label",
          "text": "$name_text",
          "size": [
            "100%-70px",
            10
          ],
          "offset": [
            18,
            0
          ],
          "font_size": "small"
        }
      },
      {
        "desc_label": {
          "type": "label",
          "text": "$desc_text",
          "size": [
            "100%-18px",
            10
          ],
          "offset": [
            18,
            11
          ],
          "font_size": "small"
        }
      },
      {
        "level_label": {
          "type": "label",
          "text": "$level_text",
          "size": [
            40,
            10
          ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "font_size": "small"
        }
      }
    ]
  },
