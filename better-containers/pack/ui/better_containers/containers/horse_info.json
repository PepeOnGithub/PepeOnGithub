{
  "namespace": "bc_horse_info",
  "info_row": {
    "type": "label",
    "text": "$line_text",
    "size": [
      "100%",
      "default"
    ],
    "font_size": "small"
  },
  "horse_info": {
    "type": "panel",
    "size": [
      144,
      "default"
    ],
    "layer": 2,
    "controls": [
      {
        "title_label": {
          "type": "label",
          "text": "%bc_horse_info.title",
          "size": [
            "100%",
            12
          ]
        }
      },
      {
        "info_lines": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [
            "100%",
            "default"
          ],
          "controls": [
            {
              "line_0@bc_horse_info.info_row": {
                "$line_text": "%bc_horse_info.line.0"
              }
            },
            {
              "line_1@bc_horse_info.info_row": {
                "$line_text": "%bc_horse_info.line.1"
              }
            },
            {
              "line_2@bc_horse_info.info_row": {
                "$line_text": "%bc_horse_info.line.2"
              }
            }
          ]
        }
      }
    ]
  }
}
