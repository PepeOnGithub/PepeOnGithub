{
  "namespace": "bc_navigation",
  "title_bar@common.root_panel": {
    "controls": [
      {
        "image": {
          "type": "image",
          "texture": "textures/ui/recipe_back_panel",
          "size": [
            "100% + 8px",
            "100% - 6px"
          ]
        }
      }
    ]
  },
  "tab_icon_frame": {
    "type": "panel",
    "size": [
      25,
      24
    ],
    "controls": [
      {
        "_tab_icon@$tab_icon": {}
      }
    ]
  },
  "tab_left_button@common_tabs.tab_left": {
    "$toggle_focus_enabled": false,
    "$radio_toggle_group": true,
    "$tab_content": "bc_navigation.tab_icon_frame",
    "size": [
      "100%",
      25
    ]
  },
  "navigation_tabs": {
    "$navigation_tabs|default": "common.empty_panel",
    "type": "panel",
    "controls": [
      {
        "_navigation_tabs@$navigation_tabs": {
          "type": "stack_panel",
          "size": [
            "100% + 4px",
            "100%"
          ],
          "orientation": "vertical",
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      }
    ]
  },
  "scroll_content": {
    "$scroll_content|default": "common.empty_panel",
    "type": "panel",
    "size": [
      "100%",
      "100%c"
    ],
    "controls": [
      {
        "_scroll_content@$scroll_content": {}
      }
    ]
  },
  "title_label": {
    "type": "label",
    "size": [
      "100%",
      10
    ],
    "text_alignment": "right",
    "color": "$title_text_color"
  },
  "tabbed_text_screen@common.root_panel": {
    "layer": 1,
    "controls": [
      {
        "navigation_tabs_2@bc_navigation.navigation_tabs": {
          "size": [
            23,
            "100%"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_right",
          "layer": 5
        }
      },
      {
        "common_panel@common.common_panel": {
          "$show_close_button": false,
          "layer": 8
        }
      },
      {
        "stack_panel": {
          "$tab_text_panel|default": "common.empty_panel",
          "type": "stack_panel",
          "size": [
            "100% - 12px",
            "100% - 12px"
          ],
          "layer": 15,
          "controls": [
            {
              "panel": {
                "type": "panel",
                "size": [
                  "100%",
                  2
                ]
              }
            },
            {
              "_tab_text_panel@$tab_text_panel": {}
            },
            {
              "hnq_65": {
                "type": "panel",
                "size": [
                  "100%",
                  2
                ]
              }
            },
            {
              "container_scroll_panel@common.container_scroll_panel": {
                "size": [
                  "100%",
                  "fill"
                ],
                "$scrolling_content": "bc_navigation.scroll_content"
              }
            }
          ]
        }
      }
    ]
  },
  "inventory_icon_image": {
    "type": "image",
    "size": [
      19,
      13
    ],
    "texture": "textures/ui/inventory_icon"
  },
  "recipe_book_icon_image": {
    "type": "image",
    "size": [
      19,
      13
    ],
    "texture": "textures/ui/recipe_book_icon"
  },
  "tab_toggle_light": {
    "type": "panel",
    "size": [
      25,
      "100%"
    ],
    "controls": [
      {
        "light_content_toggle@common_toggles.light_content_toggle": {
          "$toggle_name": "light_content_toggle",
          "$radio_toggle_group": true,
          "$toggle_group_default_selected": 0,
          "size": [
            25,
            18
          ]
        }
      }
    ]
  },
  "tab_toolbar": {
    "type": "panel",
    "size": [
      "100%cm",
      23
    ],
    "anchor_from": "top_right",
    "anchor_to": "bottom_right",
    "controls": [
      {
        "toolbar_background@common.toolbar_background_image": {
          "size": [
            "100%sm + 8px",
            27
          ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 0
        }
      },
      {
        "stack_panel_2": {
          "type": "stack_panel",
          "size": [
            "100%c",
            "100%"
          ],
          "offset": [
            0,
            2
          ],
          "orientation": "horizontal",
          "layer": 1,
          "controls": [
            {
              "panel_2": {
                "type": "panel",
                "size": [
                  4,
                  0
                ]
              }
            },
            {
              "tab_toggle_light_2@bc_navigation.tab_toggle_light": {
                "$toggle_view_binding_name": "toggle_binding_01",
                "$toggle_group_forced_index": 1,
                "$button_content": "bc_navigation.recipe_book_icon_image"
              }
            },
            {
              "panel_3": {
                "type": "panel",
                "size": [
                  1,
                  0
                ]
              }
            },
            {
              "tab_toggle_light_3@bc_navigation.tab_toggle_light": {
                "$toggle_view_binding_name": "toggle_binding_02",
                "$toggle_group_forced_index": 0,
                "$button_content": "bc_navigation.inventory_icon_image",
                "$toggle_default_state": true
              }
            },
            {
              "panel_4": {
                "type": "panel",
                "size": [
                  4,
                  0
                ]
              }
            },
            {
              "panel_5": {
                "type": "panel",
                "size": [
                  15,
                  "100%"
                ],
                "bindings": [
                  {
                    "binding_name": "#close_button_visible",
                    "binding_name_override": "#visible"
                  }
                ],
                "controls": [
                  {
                    "light_close_button@common.light_close_button": {
                      "offset": [
                        0,
                        0
                      ],
                      "anchor_from": "center",
                      "anchor_to": "center"
                    }
                  }
                ]
              }
            },
            {
              "panel_6": {
                "type": "panel",
                "size": [
                  2,
                  0
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
