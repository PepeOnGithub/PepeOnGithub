{
  "namespace": "bc_item_movement",
  "item_movement_factory": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 5,
    "$hover_control|default": "common.highlight_slot_panel",
    "controls": [
      {
        "vanilla_button": {
          "type": "panel",
          "size": [
            "100%",
            "100%"
          ],
          "controls": [
            {
              "item_button_ref@$button_ref": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "toggle_mode_reset",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "1@bc_item_movement.input_area_template": {
          "$movement_action_control": "bc_item_movement.move_one"
        }
      },
      {
        "2@bc_item_movement.input_area_template": {
          "$movement_action_control": "bc_item_movement.move_two"
        }
      },
      {
        "3@bc_item_movement.input_area_template": {
          "$movement_action_control": "bc_item_movement.move_all"
        }
      },
      {
        "4@bc_item_movement.input_area_template": {
          "$movement_action_control": "bc_item_movement.drop_one"
        }
      },
      {
        "5@bc_item_movement.input_area_template": {
          "$movement_action_control": "bc_item_movement.drop_all"
        }
      }
    ]
  },
  "input_area_template": {
    "type": "panel",
    "$movement_action_control|default": "",
    "controls": [
      {
        "$movement_action_control@$movement_action_control": {}
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "($movement_action_control - 'bc_item_movement.')",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  "move_one@bc_shared.button": {
    "$button_output_action": "button.container_auto_place_one"
  },
  "move_two": {
    "type": "panel",
    "controls": [
      {
        "drop_button_underlay@bc_item_movement.move_one": {}
      },
      {
        "input_panel_overlay@bc_shared.input_panel_overlay": {
          "$button_output_action": "button.container_auto_place_one"
        }
      }
    ]
  },
  "move_all@bc_shared.button": {
    "$button_output_action": "button.container_auto_place"
  },
  "drop_one@bc_shared.button": {
    "$button_output_action": "button.drop_one"
  },
  "drop_all@bc_shared.button": {
    "$button_output_action": "button.drop_all"
  }
}
